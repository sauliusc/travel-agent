[Unit]
Description=Travel planning console
After=network.target
# Stop retrying after 5 failures within 60s instead of crash-looping
# indefinitely (a real incident: a missing dependency once produced 170+
# restart attempts before anyone noticed) — `systemctl status
# travel-console` then shows a clear "start-limit-hit" instead of an
# ever-growing journal.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
WorkingDirectory=/opt/travel-agent
# systemd does NOT automatically populate $HOME for a unit with no User=
# set (it runs as root, but the environment isn't a login shell's) --
# the `claude` CLI subprocess agents/base.py spawns needs $HOME to find
# its subscription credentials under ~/.claude/, so this must be explicit.
Environment=HOME=/root
ExecStart=/opt/travel-agent/.venv/bin/uvicorn console.app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# console/config.py reads /etc/travel-agent/credentials.env itself at
# startup — this unit only needs read access to it, no EnvironmentFile=
# needed. Locking the file down to root is enough since the service runs
# as root (fine for a single-user personal LXC; see docs/PROXMOX_SETUP.md
# for hardening notes if you want a dedicated service user later).

[Install]
WantedBy=multi-user.target
