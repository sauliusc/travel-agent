# Vienas centrinis credential'ų šaltinis. Nukopijuok į /etc/travel-agent/credentials.env
# (žr. docs/PROXMOX_SETUP.md ir scripts/install.sh) arba, lokaliam vystymui, į .env
# repo šaknyje (jau įtraukta į .gitignore — niekada necommit'ink tikrų raktų).
#
# Anthropic prieiga ČIA NEBEREIKALINGA — agentai veikia per Claude Code CLI
# (`claude -p`) su prenumeratos autentifikacija (`claude auth login`), ne API
# raktu. console/config.py paleidimo metu patikrina `claude auth status`.

# --- GitHub --------------------------------------------------------------
# Fine-grained personal access token su Contents/Pull requests/Workflows/Pages
# read-write teisėmis. Naudoja tools/github.py (CI/CD agentas).
GITHUB_TOKEN=
# GitHub account/org, kurio vardu CI/CD agentas kuria naujas repozitorijas.
GITHUB_OWNER=sauliusc

# --- Konsolė (Caddy basic auth) ------------------------------------------
CONSOLE_BASIC_AUTH_USER=saulius
CONSOLE_BASIC_AUTH_PASSWORD=
